# Copy to .env.local (git-ignored) and fill in. Server-only values must never use the NEXT_PUBLIC_ prefix.

# Auth0 — from your Auth0 Regular Web Application (Settings tab). See authentication/README.md.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-regular-web-app-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:3001
AUTH0_AUDIENCE=https://clarity-api
API_BASE_URL=http://127.0.0.1:8001

# Gemini — powers the Future Decisions chat and its source retrieval. Key from aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional public health check. Set only to a URL and path confirmed by the backend owner.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_HEALTH_PATH=
