# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Node / Next.js
**/node_modules/
/.pnp
.pnp.js
**/.next/
/out/
/build
**/dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
**/.venv/
**/__pycache__/
*.pyc
**/.pytest_cache/

# Secrets
*.pem
**/.env
**/.env.*
!**/.env.example

# Local databases
*.db
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.duckdb

# Tests: coverage, browser authentication state and artifacts
/coverage
**/.auth/
**/test-results/
**/playwright-report/

# macOS
.DS_Store
