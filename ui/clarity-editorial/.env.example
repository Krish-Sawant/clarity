# Public connection diagnostics only. There are no verified HTTP routes yet.
# Leave blank for the fully labeled, standalone local demo.
NEXT_PUBLIC_API_BASE_URL=
# Set ONLY to a health path confirmed by the backend owner; no default invented.
NEXT_PUBLIC_API_HEALTH_PATH=
# Never add Auth0 secrets, access tokens or Gemini keys to NEXT_PUBLIC_* values.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-regular-web-app-client-id
AUTH0_CLIENT_SECRET=your-client-secret
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://127.0.0.1:3001
AUTH0_AUDIENCE=https://clarity-api
API_BASE_URL=http://127.0.0.1:8001
