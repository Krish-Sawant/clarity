# Copy to .env and fill in locally. Never commit .env.
FORK_ENV=development
# DATABASE_PATH=   (optional; defaults to data/fork_private.sqlite3)
DEMO_MODE_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_S=20
GEMINI_MAX_OUTPUT_TOKENS=1024
AI_REQUESTS_PER_USER_PER_HOUR=40
# WAREHOUSE_PATH=  (optional; defaults to the data_pipeline DuckDB file)
CORS_ORIGINS=http://localhost:3000
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://clarity-api
DEMO_MODE_ENABLED=false
CORS_ORIGINS=http://127.0.0.1:3001
